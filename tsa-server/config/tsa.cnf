# ============================================================
# Tongsuo / OpenSSL TSA 配置 (RFC 3161)
# 国密: SM2 签名证书 + SM3 摘要
# ============================================================

# --- CA 配置 ---
[ca]
default_ca = CA_default

[CA_default]
dir               = /etc/tsa
certs             = $dir/certs
new_certs_dir     = $dir/certs
database          = $dir/certs/index.txt
serial            = $dir/certs/caserial.srl
RANDFILE          = $dir/certs/.rand

certificate       = $dir/certs/cacert.pem
private_key       = $dir/certs/cakey.pem

default_md        = sm3
default_days      = 3650
default_crl_days  = 30
preserve          = no
policy            = policy_match

[policy_match]
countryName             = match
stateOrProvinceName     = match
organizationName        = match
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

# --- TSA 配置 (openssl ts -reply -section tsa) ---
[tsa]
default_tsa = tsa_config1

[tsa_config1]
dir = /etc/tsa
serial = $dir/certs/tsaserial
signer_cert = $dir/certs/tsacert.pem
signer_key = $dir/certs/tsakey.pem
certs = $dir/certs/cacert.pem
default_policy = 1.2.3.4.1
other_policies = 1.2.3.4.5
# 国密 SM3 + 常见摘要
digests = sm3, sha256, sha384, sha512
accuracy = secs:1, millisecs:0, microsecs:0
clock_precision_digits = 0
ess_cert_id_chain = no

# --- 证书请求 ---
[req]
default_bits        = 256
default_md          = sm3
distinguished_name  = req_distinguished_name
x509_extensions     = v3_ca
string_mask         = utf8only
prompt              = no

[req_distinguished_name]
C  = CN
ST = Beijing
L  = Beijing
O  = MyOrg
OU = TSA
CN = TSA Server

[v3_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true
keyUsage = critical, digitalSignature, cRLSign, keyCertSign

[v3_tsa]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, timeStamping
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
