# ============================================
# TSA Server 环境配置示例
# 复制为 .env 后按需修改:  copy .env.example .env
# ============================================

# --- 端口配置 ---
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- 证书配置 ---
CA_COUNTRY=CN
CA_STATE=Beijing
CA_LOCALITY=Beijing
CA_ORG=MyOrg
CA_OU=TSA
CA_CN=TSA Root CA
TSA_CN=TSA Server
CERT_DAYS=3650

# --- TSA 策略 OID ---
TSA_POLICY_OID=1.2.3.4.1
TSA_OTHER_POLICIES=1.2.3.4.5

# --- NTP 服务器 (chrony 镜像内默认已写死国内源，可按需改 chrony.conf) ---
NTP_SERVER1=ntp.aliyun.com
NTP_SERVER2=ntp.tencent.com
NTP_SERVER3=cn.pool.ntp.org

# --- 日志级别 ---
LOG_LEVEL=info

# --- GHCR 预构建镜像 (docker-compose.ghcr.yml) ---
# 仓库名与 owner 必须小写
GHCR_OWNER=your-org
GHCR_REPO=shijianchuo
IMAGE_TAG=latest
